{
  "name": "library-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-language-names.js",
    "build": "npm run generate && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --run --exclude \"**/*.integration.spec.ts\"",
    "test:integration": "vitest --run integration",
    "test:all": "vitest --run",
    "test:watch": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint src/ --fix",
    "lint-check": "eslint src/",
    "format": "prettier --write src/",
    "format-check": "prettier --check src/"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/roboto": "^5.2.9",
    "@mdi/js": "^7.4.47",
    "@wikimedia/language-data": "^2.0.3",
    "axios": "^1.13.5",
    "foliate-js": "^1.0.1",
    "pinia": "^4.0.3",
    "pdfjs-dist": "^6.3.289",
    "resize-observer-polyfill": "^1.5.1",
    "vue": "^3.5.28",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.2",
    "vuetify": "^3.11.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.4.47",
    "@tsconfig/node24": "^24.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.9.1",
    "cldr-localenames-full": "^48.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
